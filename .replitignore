# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
.pythonlibs/
futuretwin_embeddings/artifacts/*.npz
# Active checkpoints must be supplied before a web build. Do not exclude them.
futuretwin_embeddings/futuretwin_distilbert.zip
futuretwin_embeddings/futuretwin_distilbert_v2.zip
generated-artifacts/*
!generated-artifacts/onet_task_exposure.sqlite3
futuretwin_embeddings/data/cache/
attached_assets/
models/
futuretwin_finetuned_model/
futuretwin_training_output/
*.zip
.env
.env.*
.git/
