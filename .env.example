# Copy to .env outside Replit, or configure using Replit Secrets.
# The application reads environment variables; it does not auto-load .env.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
# Generate a unique random value once and keep it stable. Never commit it.
# Existing encrypted profiles REQUIRE the original key, not a replacement.
SESSION_SECRET=REPLACE_WITH_A_SECURE_RANDOM_VALUE
PORT=5000
# Optional: free benchmark measurement feed, NOT paid inference.
AA_API_KEY=OPTIONAL_FREE_FEED_KEY
# Optional: path to a locally provisioned faster-whisper checkpoint.
# If unset, faster-whisper can download the public "small" weights on first use.
FUTURETWIN_WHISPER_MODEL=small
